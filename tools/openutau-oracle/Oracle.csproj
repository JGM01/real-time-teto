<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <OpenUtauRoot Condition="'$(OpenUtauRoot)' == ''">../../target/p3/OpenUtau</OpenUtauRoot>
    <BaseIntermediateOutputPath>../../target/p3/dotnet/obj/</BaseIntermediateOutputPath>
    <BaseOutputPath>../../target/p3/dotnet/bin/</BaseOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(OpenUtauRoot)/OpenUtau.Plugin.Builtin/OpenUtau.Plugin.Builtin.csproj" />
  </ItemGroup>
</Project>
